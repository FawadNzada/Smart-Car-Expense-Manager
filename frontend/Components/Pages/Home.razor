@page "/"

<PageTitle>Smart Carsharing Manager</PageTitle>

<section class="hero">

    <div class="hero-left">

        <h1>Manage Shared Vehicles Smarter</h1>

        <p>
            Reserve vehicles, track trips, manage expenses
            and optimize repayments with AI-powered receipt recognition.
        </p>

        <div class="hero-buttons">
            <button class="btn-primary">Get Started</button>
            <button class="btn-secondary">Learn More</button>
        </div>

    </div>

    <div class="hero-right">

        <div class="dashboard-card">
            <h4>Vehicles</h4>
            <h2>3</h2>
        </div>

        <div class="dashboard-card">
            <h4>Reservations</h4>
            <h2>12</h2>
        </div>

        <div class="dashboard-card">
            <h4>Trips</h4>
            <h2>48</h2>
        </div>

    </div>

</section>

<section class="features">

    <h2>Features</h2>

    <div class="feature-grid">

        <div class="feature-card">
            <h3>Vehicle Management</h3>
            <p>Manage shared vehicles, license plates and availability.</p>
        </div>

        <div class="feature-card">
            <h3>Trip Tracking</h3>
            <p>Track trips, distances and vehicle usage history.</p>
        </div>

        <div class="feature-card">
            <h3>AI Receipt Recognition</h3>
            <p>Upload fuel receipts and automatically extract data.</p>
        </div>

        <div class="feature-card">
            <h3>Cost Optimization</h3>
            <p>Reduce repayments with smart debt calculations.</p>
        </div>

    </div>

</section>