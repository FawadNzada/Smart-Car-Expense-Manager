@page "/"

<PageTitle>Smart Expense Manager</PageTitle>

<section class="hero">

    <div class="hero-left">

        <h1>Manage Group Expenses Smarter</h1>

        <p>
            Track shared expenses, split bills automatically,
            and optimize repayments with AI-powered receipt recognition.
        </p>

        <div class="hero-buttons">
            <button class="btn-primary">Get Started</button>
            <button class="btn-secondary">Learn More</button>
        </div>

    </div>

    <div class="hero-right">

        <div class="dashboard-card">
            <h4>Total Balance</h4>
            <h2>€ 3,250</h2>
        </div>

        <div class="dashboard-card">
            <h4>Expenses</h4>
            <h2>€ 1,420</h2>
        </div>

        <div class="dashboard-card">
            <h4>Savings</h4>
            <h2>€ 1,830</h2>
        </div>

    </div>

</section>

<section class="features" id="features">

    <h2>Features</h2>

    <div class="feature-grid">

        <div class="feature-card">
            <h3>Group Expense Tracking</h3>
            <p>Manage expenses across trips, events and shared households.</p>
        </div>

        <div class="feature-card">
            <h3>AI Receipt Recognition</h3>
            <p>Upload receipts and automatically extract expense data.</p>
        </div>

        <div class="feature-card">
            <h3>Debt Optimization</h3>
            <p>Reduce the number of repayments with smart calculations.</p>
        </div>

        <div class="feature-card">
            <h3>Statistics & Reports</h3>
            <p>Gain insights into spending habits and group expenses.</p>
        </div>

    </div>

</section>