@page "/expensecreate"

<PageTitle>Add Expense</PageTitle>

<div class="auth-container">

    <div class="auth-card">

        <h1>Add Expense</h1>

        <p>Add a new expense to your group.</p>

        <div class="form-group">
            <label>Expense Name</label>
            <input type="text" placeholder="Enter expense name" />
        </div>

        <div class="form-group">
            <label>Amount (€)</label>
            <input type="number" placeholder="Enter amount" />
        </div>

        <div class="form-group">
            <label>Paid By</label>
            <input type="text" placeholder="Enter member name" />
        </div>

        <button class="btn-primary auth-button">
            Add Expense
        </button>

    </div>

</div>