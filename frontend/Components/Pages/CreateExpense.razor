@page "/createexpense"

@using frontend.Services

@inject ExpenseStore ExpenseStore
@inject VehicleStore VehicleStore
@inject TripStore TripStore
@inject NavigationManager Navigation

<PageTitle>New Expense</PageTitle>


<div class="create-expense-page">

    <a href="/expenses"
       class="back-link">
        ← Back to Expenses
    </a>


    <div class="create-header">

        <span>
            EXPENSE MANAGEMENT
        </span>

        <h1>New Expense</h1>

        <p>
            Add a new vehicle or trip related expense.
        </p>

    </div>


    <div class="create-layout">


        <!-- FORM -->

        <div class="create-form-card">


            <div class="form-group">

                <label>Vehicle</label>

                <select @bind="selectedLicensePlate">

                    <option value="">
                        Select vehicle
                    </option>

                    @foreach (var vehicle in VehicleStore.Vehicles)
                    {
                        <option value="@vehicle.LicensePlate">

                            @vehicle.Name
                            (@vehicle.LicensePlate)

                        </option>
                    }

                </select>

            </div>


            <div class="form-group">

                <label>Related Trip</label>

                <select @bind="selectedTripId">

                    <option value="0">
                        No related trip
                    </option>

                    @foreach (var trip in AvailableTrips)
                    {
                        <option value="@trip.Id">

                            @trip.StartLocation
                            →
                            @trip.Destination

                        </option>
                    }

                </select>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>Category</label>

                    <select @bind="category">

                        <option value="Fuel">
                            Fuel
                        </option>

                        <option value="Parking">
                            Parking
                        </option>

                        <option value="Maintenance">
                            Maintenance
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>Amount (€)</label>

                    <input type="number"
                           min="0.01"
                           step="0.01"
                           @bind="amount" />

                </div>

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>Date</label>

                    <input type="date"
                           @bind="expenseDate" />

                </div>


                <div class="form-group">

                    <label>Paid By</label>

                    <input type="text"
                           placeholder="Enter name"
                           @bind="paidBy"
                           @bind:event="oninput" />

                </div>

            </div>


            <div class="form-group">

                <label>Notes</label>

                <textarea placeholder="Optional notes..."
                          @bind="notes"
                          @bind:event="oninput">
                </textarea>

            </div>


            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error">
                    @errorMessage
                </div>
            }


            <div class="form-actions">

                <a href="/expenses"
                   class="cancel-btn">
                    Cancel
                </a>


                <button type="button"
                        class="create-btn"
                        @onclick="SaveExpense">

                    Create Expense

                </button>

            </div>

        </div>



        <!-- PREVIEW -->

        <div class="expense-preview-card">

            <span class="preview-label">
                EXPENSE PREVIEW
            </span>


            @if (SelectedVehicle is not null)
            {
                <div class="preview-vehicle">

                    <img src="@SelectedVehicle.Image"
                         alt="@SelectedVehicle.Name" />

                </div>


                <h2>
                    @SelectedVehicle.Name
                </h2>

                <span class="preview-plate">
                    @SelectedVehicle.LicensePlate
                </span>
            }
            else
            {
                <div class="empty-vehicle">
                    🚗
                </div>

                <h2>
                    Select Vehicle
                </h2>
            }


            <div class="preview-amount">

                <span>
                    @category
                </span>

                <strong>
                    @($"{amount:N2} €")
                </strong>

            </div>


            <div class="preview-info">

                <div>

                    <span>Paid By</span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(paidBy)
                            ? "Name"
                            : paidBy)
                    </strong>

                </div>


                <div>

                    <span>Date</span>

                    <strong>
                        @expenseDate.ToString("dd MMM yyyy")
                    </strong>

                </div>


                <div>

                    <span>Trip</span>

                    <strong>
                        @(SelectedTrip is null
                            ? "No trip"
                            : $"{SelectedTrip.StartLocation} → {SelectedTrip.Destination}")
                    </strong>

                </div>

            </div>

        </div>

    </div>

</div>


@code {

    private string selectedLicensePlate = "";

    private int selectedTripId;

    private string category = "Fuel";

    private decimal amount;

    private DateTime expenseDate =
        DateTime.Today;

    private string paidBy = "";

    private string notes = "";

    private string errorMessage = "";


    private VehicleItem? SelectedVehicle =>
        VehicleStore.FindVehicle(
            selectedLicensePlate);


    private IEnumerable<TripItem> AvailableTrips =>
        string.IsNullOrWhiteSpace(
            selectedLicensePlate)

            ? Enumerable.Empty<TripItem>()

            : TripStore.Trips.Where(
                trip =>
                    trip.LicensePlate.Equals(
                        selectedLicensePlate,
                        StringComparison.OrdinalIgnoreCase));


    private TripItem? SelectedTrip =>
        selectedTripId == 0

            ? null

            : TripStore.FindTrip(
                selectedTripId);


    private void SaveExpense()
    {
        errorMessage = "";


        if (SelectedVehicle is null)
        {
            errorMessage =
                "Please select a vehicle.";

            return;
        }


        if (amount <= 0)
        {
            errorMessage =
                "Amount must be greater than 0.";

            return;
        }


        if (string.IsNullOrWhiteSpace(paidBy))
        {
            errorMessage =
                "Please enter who paid the expense.";

            return;
        }


        if (expenseDate.Date > DateTime.Today)
        {
            errorMessage =
                "Expense date cannot be in the future.";

            return;
        }


        if (SelectedTrip is not null
            && !SelectedTrip.LicensePlate.Equals(
                SelectedVehicle.LicensePlate,
                StringComparison.OrdinalIgnoreCase))
        {
            errorMessage =
                "The selected trip does not belong to this vehicle.";

            return;
        }


        var expense =
            new ExpenseItem
            {
                Category =
                    category,

                Amount =
                    amount,

                Date =
                    expenseDate.Date,

                PaidBy =
                    paidBy.Trim(),

                VehicleName =
                    SelectedVehicle.Name,

                LicensePlate =
                    SelectedVehicle.LicensePlate,

                TripId =
                    SelectedTrip?.Id,

                TripRoute =
                    SelectedTrip is null
                        ? ""
                        : $"{SelectedTrip.StartLocation} → {SelectedTrip.Destination}",

                Notes =
                    notes.Trim()
            };


        ExpenseStore.AddExpense(
            expense);


        Navigation.NavigateTo(
            "/expenses");
    }

}