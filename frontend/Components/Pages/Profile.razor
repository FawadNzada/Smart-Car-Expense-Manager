@page "/profile"

@using frontend.Services

@inject AuthStore AuthStore
@inject NavigationManager Navigation

<PageTitle>Profile</PageTitle>


<div class="profile-page">

    @if (!AuthStore.IsLoggedIn
        || AuthStore.CurrentUser is null)
    {
        <div class="login-required">

            <div class="login-icon">
                👤
            </div>

            <h1>Sign in required</h1>

            <p>
                Sign in to view and manage your profile.
            </p>

            <a href="/login">
                Sign In
            </a>

        </div>
    }
    else
    {
        <div class="profile-header">

            <div>

                <span class="eyebrow">
                    ACCOUNT
                </span>

                <h1>Profile</h1>

                <p>
                    Manage your personal account information.
                </p>

            </div>


            <button type="button"
                    class="logout-btn"
                    @onclick="Logout">
                Sign Out
            </button>

        </div>


        <div class="profile-layout">

            <!-- PROFILE CARD -->

            <div class="profile-card">

                <div class="avatar">
                    @GetInitials(AuthStore.CurrentUser.FullName)
                </div>


                <h2>
                    @AuthStore.CurrentUser.FullName
                </h2>


                <span class="profile-email">
                    @AuthStore.CurrentUser.Email
                </span>


                <div class="member-since">

                    <span>
                        Member since
                    </span>

                    <strong>
                        @AuthStore.CurrentUser.CreatedAt.ToString("dd MMM yyyy")
                    </strong>

                </div>

            </div>


            <!-- SETTINGS -->

            <div class="settings-card">

                <div class="settings-header">

                    <div>

                        <span>
                            PROFILE INFORMATION
                        </span>

                        <h2>
                            Personal Details
                        </h2>

                    </div>


                    @if (!editMode)
                    {
                        <button type="button"
                                class="edit-profile-btn"
                                @onclick="StartEditing">
                            Edit Profile
                        </button>
                    }

                </div>


                @if (!editMode)
                {
                    <div class="profile-info-grid">

                        <div class="info-item">

                            <span>Full Name</span>

                            <strong>
                                @AuthStore.CurrentUser.FullName
                            </strong>

                        </div>


                        <div class="info-item">

                            <span>Email</span>

                            <strong>
                                @AuthStore.CurrentUser.Email
                            </strong>

                        </div>


                        <div class="info-item">

                            <span>Phone</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(AuthStore.CurrentUser.Phone)
                                    ? "Not provided"
                                    : AuthStore.CurrentUser.Phone)
                            </strong>

                        </div>


                        <div class="info-item">

                            <span>Location</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(AuthStore.CurrentUser.Location)
                                    ? "Not provided"
                                    : AuthStore.CurrentUser.Location)
                            </strong>

                        </div>

                    </div>
                }
                else
                {
                    <div class="edit-form">

                        <div class="form-group">

                            <label>Full Name</label>

                            <input type="text"
                                   @bind="fullName"
                                   @bind:event="oninput" />

                        </div>


                        <div class="form-group">

                            <label>Email</label>

                            <input type="email"
                                   value="@AuthStore.CurrentUser.Email"
                                   disabled />

                            <small>
                                Email changes will be handled by the backend later.
                            </small>

                        </div>


                        <div class="form-group">

                            <label>Phone</label>

                            <input type="text"
                                   placeholder="Optional"
                                   @bind="phone"
                                   @bind:event="oninput" />

                        </div>


                        <div class="form-group">

                            <label>Location</label>

                            <input type="text"
                                   placeholder="e.g. Linz"
                                   @bind="location"
                                   @bind:event="oninput" />

                        </div>


                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="form-error">
                                @errorMessage
                            </div>
                        }


                        <div class="form-actions">

                            <button type="button"
                                    class="cancel-btn"
                                    @onclick="CancelEditing">
                                Cancel
                            </button>

                            <button type="button"
                                    class="save-btn"
                                    @onclick="SaveProfile">
                                Save Changes
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>
    }

</div>


@code {

    private bool editMode;

    private string fullName = "";

    private string phone = "";

    private string location = "";

    private string errorMessage = "";


    private void StartEditing()
    {
        if (AuthStore.CurrentUser is null)
        {
            return;
        }


        fullName =
            AuthStore.CurrentUser.FullName;

        phone =
            AuthStore.CurrentUser.Phone;

        location =
            AuthStore.CurrentUser.Location;

        errorMessage = "";

        editMode = true;
    }


    private void CancelEditing()
    {
        editMode = false;

        errorMessage = "";
    }


    private void SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(fullName))
        {
            errorMessage =
                "Name cannot be empty.";

            return;
        }


        AuthStore.UpdateProfile(
            fullName,
            phone,
            location);


        editMode = false;

        errorMessage = "";
    }


    private void Logout()
    {
        AuthStore.Logout();

        Navigation.NavigateTo(
            "/");
    }


    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return parts[0][0]
                .ToString()
                .ToUpper();
        }


        return
            $"{parts[0][0]}{parts[^1][0]}"
            .ToUpper();
    }

}