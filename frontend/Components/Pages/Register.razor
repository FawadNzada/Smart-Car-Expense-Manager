@page "/register"

<PageTitle>Register</PageTitle>

<div class="auth-page">

    <div class="auth-panel">

        <div class="auth-brand">
            <span>SMART CARSHARING</span>
            <h1>Create your account</h1>
            <p>Join your carsharing group and start managing shared vehicle costs.</p>
        </div>

        <div class="auth-form-card">

            <h2>Register</h2>
            <p>Create a new Smart Carsharing account.</p>

            <div class="form-row">

                <div class="form-group">
                    <label>First Name</label>
                    <input type="text"
                           placeholder="Sebastian" />
                </div>

                <div class="form-group">
                    <label>Last Name</label>
                    <input type="text"
                           placeholder="Junior" />
                </div>

            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email"
                       placeholder="Enter your email" />
            </div>

            <div class="form-row">

                <div class="form-group">
                    <label>Password</label>
                    <input type="password"
                           placeholder="Create password" />
                </div>

                <div class="form-group">
                    <label>Confirm Password</label>
                    <input type="password"
                           placeholder="Repeat password" />
                </div>

            </div>

            <label class="terms">
                <input type="checkbox" />
                <span>I agree to the terms and conditions.</span>
            </label>

            <button class="auth-main-btn">
                Create Account
            </button>

            <div class="auth-switch">
                <span>Already have an account?</span>
                <a href="/login">Login</a>
            </div>

        </div>

    </div>

</div>