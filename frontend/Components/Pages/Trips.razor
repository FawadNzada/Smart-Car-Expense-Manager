@page "/trips"

@using frontend.Services

@inject TripStore TripStore

<PageTitle>Trips</PageTitle>

<div class="trips-page">

    <div class="trips-header">

        <div>
            <span class="eyebrow">
                TRIP MANAGEMENT
            </span>

            <h1>Trips</h1>

            <p>
                Manage planned, active and completed vehicle trips.
            </p>
        </div>

        <a href="/createtrip"
           class="new-trip-btn">
            + New Trip
        </a>

    </div>


    <div class="trip-tabs">

        <button class="@GetTabClass("All")"
                @onclick='() => SetFilter("All")'>
            All
        </button>

        <button class="@GetTabClass("Planned")"
                @onclick='() => SetFilter("Planned")'>
            Planned
        </button>

        <button class="@GetTabClass("Active")"
                @onclick='() => SetFilter("Active")'>
            Active
        </button>

        <button class="@GetTabClass("Completed")"
                @onclick='() => SetFilter("Completed")'>
            Completed
        </button>

        <button class="@GetTabClass("Cancelled")"
                @onclick='() => SetFilter("Cancelled")'>
            Cancelled
        </button>

    </div>


    <div class="trips-list">

        @if (!FilteredTrips.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    🚘
                </div>

                <h3>No trips found</h3>

                <p>
                    There are currently no trips in this category.
                </p>

            </div>
        }
        else
        {
            @foreach (var trip in FilteredTrips)
            {
                <a href="@($"/trips/{trip.Id}")"
                   class="trip-card trip-card-link">

                    <div class="vehicle-image">

                        <img src="@trip.VehicleImage"
                             alt="@trip.VehicleName" />

                    </div>


                    <div class="trip-main">

                        <div class="trip-title-row">

                            <div>

                                <h2>
                                    @trip.VehicleName
                                </h2>

                                <span class="license-plate">
                                    @trip.LicensePlate
                                </span>

                            </div>

                            <span class="status-badge @GetStatusClass(trip.Status)">
                                @trip.Status
                            </span>

                        </div>


                        <div class="route">

                            <div class="route-point">

                                <span class="route-dot"></span>

                                <div>

                                    <small>FROM</small>

                                    <strong>
                                        @trip.StartLocation
                                    </strong>

                                </div>

                            </div>


                            <div class="route-line"></div>


                            <div class="route-point">

                                <span class="route-dot destination"></span>

                                <div>

                                    <small>TO</small>

                                    <strong>
                                        @trip.Destination
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <div class="trip-info-grid">

                            <div class="info-box">

                                <span>Driver</span>

                                <strong>
                                    @trip.Driver
                                </strong>

                            </div>

                            <div class="info-box">

                                <span>Date</span>

                                <strong>
                                    @trip.Date.ToString("dd MMM yyyy")
                                </strong>

                            </div>

                            <div class="info-box">

                                <span>Time</span>

                                <strong>
                                    @trip.StartTime.ToString("HH:mm")
                                    -
                                    @trip.EndTime.ToString("HH:mm")
                                </strong>

                            </div>

                            <div class="info-box">

                                <span>Distance</span>

                                <strong>
                                    @GetDistance(trip)
                                </strong>

                            </div>

                        </div>

                    </div>

                </a>
            }
        }

    </div>

</div>


@code {

    private string activeFilter = "All";


    private IEnumerable<TripItem> FilteredTrips
    {
        get
        {
            var trips =
                TripStore.Trips
                    .OrderByDescending(trip => trip.Date)
                    .ThenBy(trip => trip.StartTime);


            return activeFilter switch
            {
                "Planned" =>
                    trips.Where(
                        trip => trip.Status == "Planned"),

                "Active" =>
                    trips.Where(
                        trip => trip.Status == "Active"),

                "Completed" =>
                    trips.Where(
                        trip => trip.Status == "Completed"),

                "Cancelled" =>
                    trips.Where(
                        trip => trip.Status == "Cancelled"),

                _ => trips
            };
        }
    }


    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }


    private string GetTabClass(string filter)
    {
        return activeFilter == filter
            ? "tab-btn active"
            : "tab-btn";
    }


    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Planned" => "planned",
            "Active" => "active",
            "Completed" => "completed",
            "Cancelled" => "cancelled",
            _ => "planned"
        };
    }


    private string GetDistance(TripItem trip)
    {
        if (trip.EndMileage <= 0
            || trip.EndMileage < trip.StartMileage)
        {
            return "-";
        }

        return $"{trip.EndMileage - trip.StartMileage} km";
    }

}