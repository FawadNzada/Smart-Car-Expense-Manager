@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">

    <div class="dashboard-header">
        <div>
            <h1>Dashboard</h1>
            <p>Overview of your carsharing group.</p>
        </div>

        <div class="dashboard-actions">
            <input type="text"
                   class="dashboard-search"
                   placeholder="Search..." />

            <button class="notification-btn">
                🔔
            </button>

            <div class="profile-circle">
                SJ
            </div>
        </div>
    </div>


    <!-- STATISTICS -->

    <div class="stats-grid">

        <div class="stat-card">
            <div class="stat-icon">🚗</div>

            <div>
                <span>Vehicles</span>
                <strong>3</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">📅</div>

            <div>
                <span>Reservations</span>
                <strong>12</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">🛣️</div>

            <div>
                <span>Trips</span>
                <strong>48</strong>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-icon">💰</div>

            <div>
                <span>Total Expenses</span>
                <strong>€ 860</strong>
            </div>
        </div>

    </div>


    <!-- CURRENT VEHICLE -->

    <div class="section-header">
        <div>
            <h2>Current Vehicle</h2>
            <p>Your currently selected vehicle.</p>
        </div>

        <a href="/vehicles" class="view-all-link">
            View Vehicles →
        </a>
    </div>

    <div class="current-vehicle-card">

        <div class="current-vehicle-info">

            <div class="vehicle-title-row">
                <div>
                    <span class="section-label">
                        CURRENT VEHICLE
                    </span>

                    <h2>Volkswagen Golf</h2>
                    <p>L-123AB</p>
                </div>

                <span class="status-badge">
                    Available
                </span>
            </div>

            <div class="vehicle-dashboard-stats">

                <div class="vehicle-stat">
                    <span>Fuel Level</span>
                    <strong>75%</strong>
                </div>

                <div class="vehicle-stat">
                    <span>Mileage</span>
                    <strong>48,250 km</strong>
                </div>

                <div class="vehicle-stat">
                    <span>Reservations</span>
                    <strong>12</strong>
                </div>

            </div>

            <div class="fuel-wrapper">
                <div class="fuel-label">
                    <span>⛽ Fuel</span>
                    <span>75%</span>
                </div>

                <div class="fuel-bar">
                    <div class="fuel-fill"></div>
                </div>
            </div>

        </div>


        <div class="current-vehicle-image">
            <img src="images/vehicles/vw.png"
                 alt="Volkswagen Golf" />
        </div>

    </div>


    <!-- LOWER DASHBOARD -->

    <div class="dashboard-bottom-grid">


        <!-- RECENT ACTIVITY -->

        <div class="dashboard-panel">

            <div class="panel-header">
                <h2>Recent Activity</h2>

                <a href="/trips">
                    View All
                </a>
            </div>

            <div class="activity-list">

                <div class="activity-row">
                    <div class="activity-icon">📅</div>

                    <div class="activity-main">
                        <strong>New reservation</strong>
                        <span>Volkswagen Golf</span>
                    </div>

                    <div class="activity-meta">
                        Today, 14:30
                    </div>
                </div>

                <div class="activity-row">
                    <div class="activity-icon">⛽</div>

                    <div class="activity-main">
                        <strong>Fuel expense added</strong>
                        <span>€45.00</span>
                    </div>

                    <div class="activity-meta">
                        Today, 11:20
                    </div>
                </div>

                <div class="activity-row">
                    <div class="activity-icon">🛣️</div>

                    <div class="activity-main">
                        <strong>Trip completed</strong>
                        <span>32 km</span>
                    </div>

                    <div class="activity-meta">
                        Yesterday
                    </div>
                </div>

                <div class="activity-row">
                    <div class="activity-icon">🚗</div>

                    <div class="activity-main">
                        <strong>Vehicle added</strong>
                        <span>BMW 3 Series</span>
                    </div>

                    <div class="activity-meta">
                        Yesterday
                    </div>
                </div>

            </div>

        </div>


        <!-- UPCOMING RESERVATIONS -->

        <div class="dashboard-panel">

            <div class="panel-header">
                <h2>Upcoming Reservations</h2>

                <a href="/reservations">
                    View All
                </a>
            </div>

            <div class="reservation-list">

                <div class="reservation-row">

                    <div class="reservation-date">
                        <strong>24</strong>
                        <span>SEP</span>
                    </div>

                    <div class="reservation-info">
                        <strong>Volkswagen Golf</strong>
                        <span>John Doe</span>
                    </div>

                    <div class="reservation-time">
                        15:00 – 18:00
                    </div>

                </div>


                <div class="reservation-row">

                    <div class="reservation-date">
                        <strong>25</strong>
                        <span>SEP</span>
                    </div>

                    <div class="reservation-info">
                        <strong>BMW 3 Series</strong>
                        <span>Emily</span>
                    </div>

                    <div class="reservation-time">
                        10:00 – 13:00
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>