@page "/vehicles"

@using frontend.Services
@inject VehicleStore VehicleStore

<PageTitle>Vehicles</PageTitle>

<div class="vehicles-page">

    <div class="vehicles-header">

        <div>
            <h1>Vehicles</h1>

            <p>
                Manage all vehicles in your carsharing group.
            </p>
        </div>

        <a href="/vehiclecreate"
           class="add-vehicle-btn">
            + Add Vehicle
        </a>

    </div>


    <!-- SEARCH + FILTER -->

    <div class="vehicle-toolbar">

        <input type="text"
               class="vehicle-search"
               placeholder="Search by vehicle or license plate..."
               @bind="searchTerm"
               @bind:event="oninput" />

        <select class="filter-btn"
                @bind="selectedStatus">

            <option value="All">
                All Status
            </option>

            <option value="Available">
                Available
            </option>

            <option value="In Use">
                In Use
            </option>

            <option value="Reserved">
                Reserved
            </option>

            <option value="Unavailable">
                Unavailable
            </option>

        </select>

    </div>


    <!-- VEHICLE LIST -->

    @if (FilteredVehicles.Any())
    {
        <div class="vehicles-grid">

            @foreach (var vehicle in FilteredVehicles)
            {
                <a href="@($"/vehicles/{vehicle.LicensePlate}")"
                   class="vehicle-card vehicle-card-link">

                    <div class="vehicle-image">

                        <div class="vehicle-status @vehicle.StatusClass">
                            @vehicle.Status
                        </div>

                        @if (!string.IsNullOrWhiteSpace(vehicle.Image))
                        {
                            <img src="@vehicle.Image"
                                 alt="@vehicle.Name"
                                 class="vehicle-photo" />
                        }
                        else
                        {
                            <div class="vehicle-image-placeholder">
                                🚗
                            </div>
                        }

                    </div>


                    <div class="vehicle-card-content">

                        <h3>
                            @vehicle.Name
                        </h3>

                        <span class="license-plate">
                            @vehicle.LicensePlate
                        </span>


                        <div class="fuel-section">

                            <div class="fuel-info">

                                <span>
                                    ⛽ Fuel Level
                                </span>

                                <strong>
                                    @vehicle.FuelLevel%
                                </strong>

                            </div>


                            <div class="fuel-bar">

                                <div class="fuel-fill"
                                     style="width: @(vehicle.FuelLevel)%;">
                                </div>

                            </div>

                        </div>

                    </div>

                </a>
            }

        </div>
    }
    else
    {
        <div class="no-vehicles">

            <h3>
                No vehicles found
            </h3>

            <p>
                Try another search term or status filter.
            </p>

            <button type="button"
                    class="filter-btn"
                    @onclick="ResetFilters">
                Reset Filters
            </button>

        </div>
    }

</div>


@code {

    private string searchTerm = "";

    private string selectedStatus = "All";


    private IEnumerable<VehicleItem> FilteredVehicles
    {
        get
        {
            IEnumerable<VehicleItem> result =
                VehicleStore.Vehicles;


            // SEARCH

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var search =
                    searchTerm.Trim();

                result = result.Where(vehicle =>
                    vehicle.Name.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    vehicle.LicensePlate.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    vehicle.Brand.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    vehicle.Model.Contains(
                        search,
                        StringComparison.OrdinalIgnoreCase));
            }


            // STATUS FILTER

            if (selectedStatus != "All")
            {
                result = result.Where(vehicle =>
                    vehicle.Status.Equals(
                        selectedStatus,
                        StringComparison.OrdinalIgnoreCase));
            }


            return result;
        }
    }


    private void ResetFilters()
    {
        searchTerm = "";

        selectedStatus = "All";
    }

}