@page "/createreservation"

<PageTitle>Create Reservation</PageTitle>

<div class="create-reservation-page">

    <a href="/reservations" class="back-link">
        ← Back to Reservations
    </a>

    <div class="page-header">
        <h1>Create Reservation</h1>
        <p>Reserve a vehicle for a specific date and time.</p>
    </div>

    <div class="reservation-layout">

        <div class="reservation-form-card">

            <div class="card-heading">
                <div class="heading-icon">📅</div>

                <div>
                    <h2>Reservation Details</h2>
                    <p>Choose a vehicle and reservation period.</p>
                </div>
            </div>

            <div class="form-grid">

                <div class="form-field full-width">
                    <label>Vehicle</label>

                    <select>
                        <option>Volkswagen Golf</option>
                        <option>BMW 3 Series</option>
                        <option>Audi A4</option>
                        <option>Mercedes C-Class</option>
                    </select>
                </div>

                <div class="form-field">
                    <label>Date</label>
                    <input type="date" />
                </div>

                <div class="form-field">
                    <label>Driver</label>
                    <input type="text" placeholder="e.g. Sebastian" />
                </div>

                <div class="form-field">
                    <label>Start Time</label>
                    <input type="time" />
                </div>

                <div class="form-field">
                    <label>End Time</label>
                    <input type="time" />
                </div>

                <div class="form-field full-width">
                    <label>Notes</label>
                    <textarea placeholder="Optional notes..."></textarea>
                </div>

            </div>

            <div class="form-actions">

                <a href="/reservations" class="cancel-btn">
                    Cancel
                </a>

                <button class="save-btn">
                    + Create Reservation
                </button>

            </div>

        </div>

        <div class="reservation-preview-card">

            <div class="card-heading">
                <div class="heading-icon">🚗</div>

                <div>
                    <h2>Reservation Preview</h2>
                    <p>This is how your reservation will appear.</p>
                </div>
            </div>

            <div class="preview-image">
                <img src="images/vehicles/vw.png"
                     alt="Volkswagen Golf" />
            </div>

            <div class="preview-content">

                <div class="preview-title-row">
                    <div>
                        <h2>Volkswagen Golf</h2>
                        <span>L-123AB</span>
                    </div>

                    <span class="status-badge">
                        Available
                    </span>
                </div>

                <div class="preview-info-grid">

                    <div class="preview-info">
                        <span>Date</span>
                        <strong>24 Sep 2026</strong>
                    </div>

                    <div class="preview-info">
                        <span>Driver</span>
                        <strong>Sebastian</strong>
                    </div>

                    <div class="preview-info">
                        <span>Start</span>
                        <strong>15:00</strong>
                    </div>

                    <div class="preview-info">
                        <span>End</span>
                        <strong>18:00</strong>
                    </div>

                </div>

                <div class="reservation-duration">
                    <span>Reservation Duration</span>
                    <strong>3 hours</strong>
                </div>

            </div>

        </div>

    </div>

</div>
