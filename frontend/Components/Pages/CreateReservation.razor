@page "/createreservation"

@using frontend.Services

@inject VehicleStore VehicleStore
@inject ReservationStore ReservationStore
@inject NavigationManager Navigation

<PageTitle>New Reservation</PageTitle>


<div class="create-reservation-page">

    <a href="/reservations"
       class="back-link">
        ← Back to Reservations
    </a>


    <div class="create-header">

        <span>RESERVATION MANAGEMENT</span>

        <h1>New Reservation</h1>

        <p>
            Create a new vehicle reservation.
        </p>

    </div>


    <div class="create-layout">

        <!-- FORM -->

        <div class="create-form-card">


            <div class="form-group">

                <label>Vehicle</label>

                <select @bind="selectedLicensePlate">

                    <option value="">
                        Select vehicle
                    </option>

                    @foreach (var vehicle in VehicleStore.Vehicles)
                    {
                        <option value="@vehicle.LicensePlate">

                            @vehicle.Name
                            (@vehicle.LicensePlate)

                        </option>
                    }

                </select>

            </div>


            <div class="form-group">

                <label>Driver</label>

                <input type="text"
                       placeholder="Enter driver name"
                       @bind="driver"
                       @bind:event="oninput" />

            </div>


            <div class="form-group">

                <label>Date</label>

                <input type="date"
                       @bind="reservationDate" />

            </div>


            <div class="form-row">

                <div class="form-group">

                    <label>Start Time</label>

                    <input type="time"
                           @bind="startTime" />

                </div>


                <div class="form-group">

                    <label>End Time</label>

                    <input type="time"
                           @bind="endTime" />

                </div>

            </div>


            <div class="form-group">

                <label>Notes</label>

                <textarea placeholder="Optional notes..."
                          @bind="notes"
                          @bind:event="oninput">
                </textarea>

            </div>


            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error">
                    @errorMessage
                </div>
            }


            <div class="form-actions">

                <a href="/reservations"
                   class="cancel-btn">
                    Cancel
                </a>


                <button type="button"
                        class="create-btn"
                        @onclick="SaveReservation">

                    Create Reservation

                </button>

            </div>

        </div>


        <!-- PREVIEW -->

        <div class="reservation-preview-card">

            <span class="preview-label">
                RESERVATION PREVIEW
            </span>


            @if (SelectedVehicle is not null)
            {
                <div class="preview-vehicle">

                    <img src="@SelectedVehicle.Image"
                         alt="@SelectedVehicle.Name" />

                </div>


                <div class="preview-content">

                    <h2>
                        @SelectedVehicle.Name
                    </h2>

                    <span class="preview-plate">
                        @SelectedVehicle.LicensePlate
                    </span>


                    <div class="preview-info">

                        <div>

                            <span>Driver</span>

                            <strong>
                                @(string.IsNullOrWhiteSpace(driver)
                                    ? "Driver"
                                    : driver)
                            </strong>

                        </div>


                        <div>

                            <span>Date</span>

                            <strong>
                                @reservationDate.ToString("dd MMM yyyy")
                            </strong>

                        </div>


                        <div>

                            <span>Time</span>

                            <strong>
                                @startTime.ToString("HH:mm")
                                -
                                @endTime.ToString("HH:mm")
                            </strong>

                        </div>


                        <div>

                            <span>Duration</span>

                            <strong>
                                @GetDurationText()
                            </strong>

                        </div>

                    </div>

                </div>
            }
            else
            {
                <div class="empty-preview">

                    <div class="empty-preview-icon">
                        🚗
                    </div>

                    <h3>Select a vehicle</h3>

                    <p>
                        Your reservation preview will appear here.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


@code {

    private string selectedLicensePlate = "";

    private string driver = "";

    private DateTime reservationDate =
        DateTime.Today;

    private TimeOnly startTime =
        new TimeOnly(9, 0);

    private TimeOnly endTime =
        new TimeOnly(10, 0);

    private string notes = "";

    private string errorMessage = "";


    private VehicleItem? SelectedVehicle =>
        VehicleStore.FindVehicle(
            selectedLicensePlate);


    private void SaveReservation()
    {
        errorMessage = "";


        if (SelectedVehicle is null)
        {
            errorMessage =
                "Please select a vehicle.";

            return;
        }


        if (string.IsNullOrWhiteSpace(driver))
        {
            errorMessage =
                "Please enter a driver.";

            return;
        }


        if (reservationDate.Date < DateTime.Today)
        {
            errorMessage =
                "Reservation date cannot be in the past.";

            return;
        }


        if (endTime <= startTime)
        {
            errorMessage =
                "End time must be after start time.";

            return;
        }


        var start =
            startTime.ToTimeSpan();

        var end =
            endTime.ToTimeSpan();


        if (ReservationStore.HasConflict(
                SelectedVehicle.LicensePlate,
                reservationDate,
                start,
                end))
        {
            errorMessage =
                "This vehicle is already reserved during this time.";

            return;
        }


        var reservation =
            new ReservationItem
            {
                VehicleName =
                    SelectedVehicle.Name,

                LicensePlate =
                    SelectedVehicle.LicensePlate,

                VehicleImage =
                    SelectedVehicle.Image,

                Driver =
                    driver.Trim(),

                Date =
                    reservationDate.Date,

                StartTime =
                    start,

                EndTime =
                    end,

                Status =
                    "Planned",

                Notes =
                    notes.Trim()
            };


        ReservationStore.AddReservation(
            reservation);


        Navigation.NavigateTo(
            "/reservations");
    }


    private string GetDurationText()
    {
        if (endTime <= startTime)
        {
            return "-";
        }


        var duration =
            endTime - startTime;


        if (duration.Minutes == 0)
        {
            return $"{duration.Hours} h";
        }


        return
            $"{duration.Hours} h {duration.Minutes} min";
    }

}