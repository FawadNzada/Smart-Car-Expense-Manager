@page "/expenses"

@using frontend.Services

@inject ExpenseStore ExpenseStore

<PageTitle>Expenses</PageTitle>

<div class="expenses-page">

    <div class="expenses-header">

        <div>
            <span class="eyebrow">
                EXPENSE MANAGEMENT
            </span>

            <h1>Expenses</h1>

            <p>
                Track vehicle and trip related expenses.
            </p>
        </div>

        <a href="/createexpense"
           class="new-expense-btn">
            + New Expense
        </a>

    </div>


    <div class="summary-grid">

        <div class="summary-card">
            <span>Total Expenses</span>
            <strong>@FormatMoney(TotalExpenses)</strong>
        </div>

        <div class="summary-card">
            <span>Fuel</span>
            <strong>@FormatMoney(GetCategoryTotal("Fuel"))</strong>
        </div>

        <div class="summary-card">
            <span>Parking</span>
            <strong>@FormatMoney(GetCategoryTotal("Parking"))</strong>
        </div>

        <div class="summary-card">
            <span>Maintenance</span>
            <strong>@FormatMoney(GetCategoryTotal("Maintenance"))</strong>
        </div>

    </div>


    <div class="expense-tabs">

        <button class="@GetTabClass("All")"
                @onclick='() => SetFilter("All")'>
            All
        </button>

        <button class="@GetTabClass("Fuel")"
                @onclick='() => SetFilter("Fuel")'>
            Fuel
        </button>

        <button class="@GetTabClass("Parking")"
                @onclick='() => SetFilter("Parking")'>
            Parking
        </button>

        <button class="@GetTabClass("Maintenance")"
                @onclick='() => SetFilter("Maintenance")'>
            Maintenance
        </button>

        <button class="@GetTabClass("Other")"
                @onclick='() => SetFilter("Other")'>
            Other
        </button>

    </div>


    <div class="expenses-list">

        @if (!FilteredExpenses.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    💶
                </div>

                <h3>No expenses found</h3>

                <p>
                    There are currently no expenses in this category.
                </p>

            </div>
        }
        else
        {
            @foreach (var expense in FilteredExpenses)
            {
                <a href="@($"/expenses/{expense.Id}")"
                   class="expense-card expense-card-link">

                    <div class="category-icon @GetCategoryClass(expense.Category)">
                        @GetCategoryIcon(expense.Category)
                    </div>


                    <div class="expense-main">

                        <div class="expense-title-row">

                            <div>

                                <h2>
                                    @expense.Category
                                </h2>

                                <span class="vehicle-name">
                                    @expense.VehicleName · @expense.LicensePlate
                                </span>

                            </div>


                            <strong class="expense-amount">
                                @FormatMoney(expense.Amount)
                            </strong>

                        </div>


                        <div class="expense-info-grid">

                            <div class="info-box">

                                <span>Paid By</span>

                                <strong>
                                    @expense.PaidBy
                                </strong>

                            </div>


                            <div class="info-box">

                                <span>Date</span>

                                <strong>
                                    @expense.Date.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <div class="info-box">

                                <span>Trip</span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(expense.TripRoute)
                                        ? "No trip"
                                        : expense.TripRoute)
                                </strong>

                            </div>


                            <div class="info-box">

                                <span>Notes</span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(expense.Notes)
                                        ? "-"
                                        : expense.Notes)
                                </strong>

                            </div>

                        </div>

                    </div>

                </a>
            }
        }

    </div>

</div>


@code {

    private string activeFilter = "All";


    private decimal TotalExpenses =>
        ExpenseStore.Expenses.Sum(
            expense => expense.Amount);


    private IEnumerable<ExpenseItem> FilteredExpenses
    {
        get
        {
            var expenses =
                ExpenseStore.Expenses
                    .OrderByDescending(
                        expense => expense.Date)
                    .ThenByDescending(
                        expense => expense.Id);


            if (activeFilter == "All")
            {
                return expenses;
            }


            return expenses.Where(
                expense =>
                    expense.Category == activeFilter);
        }
    }


    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }


    private string GetTabClass(string filter)
    {
        return activeFilter == filter
            ? "tab-btn active"
            : "tab-btn";
    }


    private decimal GetCategoryTotal(string category)
    {
        return ExpenseStore.Expenses
            .Where(expense =>
                expense.Category == category)
            .Sum(expense =>
                expense.Amount);
    }


    private string FormatMoney(decimal amount)
    {
        return $"{amount:N2} €";
    }


    private string GetCategoryClass(string category)
    {
        return category switch
        {
            "Fuel" => "fuel",
            "Parking" => "parking",
            "Maintenance" => "maintenance",
            _ => "other"
        };
    }


    private string GetCategoryIcon(string category)
    {
        return category switch
        {
            "Fuel" => "⛽",
            "Parking" => "🅿️",
            "Maintenance" => "🔧",
            _ => "💳"
        };
    }

}