@page "/groups"

@using frontend.Services

@inject GroupStore GroupStore
@inject VehicleStore VehicleStore

<PageTitle>Groups</PageTitle>


<div class="groups-page">

    <div class="groups-header">

        <div>

            <span class="eyebrow">
                GROUP MANAGEMENT
            </span>

            <h1>Groups</h1>

            <p>
                Manage carsharing groups, members and vehicles.
            </p>

        </div>


        <a href="/creategroup"
           class="new-group-btn">

            + New Group

        </a>

    </div>


    <div class="groups-summary">

        <div class="summary-card">

            <span>Total Groups</span>

            <strong>
                @GroupStore.Groups.Count
            </strong>

        </div>


        <div class="summary-card">

            <span>Total Members</span>

            <strong>
                @TotalMembers
            </strong>

        </div>


        <div class="summary-card">

            <span>Assigned Vehicles</span>

            <strong>
                @AssignedVehicles
            </strong>

        </div>


        <div class="summary-card">

            <span>Available Vehicles</span>

            <strong>
                @AvailableVehicles
            </strong>

        </div>

    </div>


    <div class="groups-grid">

        @if (!GroupStore.Groups.Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    👥
                </div>

                <h3>No groups yet</h3>

                <p>
                    Create your first carsharing group.
                </p>

                <a href="/creategroup">
                    Create Group
                </a>

            </div>
        }
        else
        {
            @foreach (var group in GroupStore.Groups)
            {
                <a href="@($"/groups/{group.Id}")"
                   class="group-card">

                    <div class="group-card-top">

                        <div class="group-icon">
                            👥
                        </div>


                        <div class="group-main">

                            <h2>
                                @group.Name
                            </h2>

                            <span>
                                Owner: @group.Owner
                            </span>

                        </div>

                    </div>


                    <p class="group-description">
                        @(string.IsNullOrWhiteSpace(group.Description)
                            ? "No description."
                            : group.Description)
                    </p>


                    <div class="group-stats">

                        <div>

                            <span>Members</span>

                            <strong>
                                @group.Members.Count
                            </strong>

                        </div>


                        <div>

                            <span>Vehicles</span>

                            <strong>
                                @group.VehicleLicensePlates.Count
                            </strong>

                        </div>


                        <div>

                            <span>Created</span>

                            <strong>
                                @group.CreatedAt.ToString("dd MMM yyyy")
                            </strong>

                        </div>

                    </div>


                    <div class="member-preview">

                        @foreach (var member in group.Members.Take(3))
                        {
                            <div class="member-avatar"
                                 title="@member">

                                @GetInitials(member)

                            </div>
                        }


                        @if (group.Members.Count > 3)
                        {
                            <div class="member-avatar more">
                                +@(group.Members.Count - 3)
                            </div>
                        }

                    </div>


                    <div class="vehicle-preview-list">

                        @foreach (var licensePlate in group.VehicleLicensePlates.Take(3))
                        {
                            var vehicle =
                                VehicleStore.FindVehicle(
                                    licensePlate);

                            @if (vehicle is not null)
                            {
                                <div class="vehicle-chip">

                                    <img src="@vehicle.Image"
                                         alt="@vehicle.Name" />

                                    <span>
                                        @vehicle.Name
                                    </span>

                                </div>
                            }
                        }

                    </div>

                </a>
            }
        }

    </div>

</div>


@code {

    private int TotalMembers =>
        GroupStore.Groups
            .SelectMany(group => group.Members)
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .Count();


    private int AssignedVehicles =>
        GroupStore.Groups
            .SelectMany(
                group => group.VehicleLicensePlates)
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .Count();


    private int AvailableVehicles =>
        VehicleStore.Vehicles.Count(
            vehicle =>
                vehicle.Status == "Available");


    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return parts[0]
                .Substring(0, 1)
                .ToUpper();
        }


        return
            $"{parts[0][0]}{parts[^1][0]}"
            .ToUpper();
    }

}