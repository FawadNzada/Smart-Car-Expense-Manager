@page "/debts"

<PageTitle>Debts</PageTitle>

<div class="debts-page">

    <div class="debts-header">
        <div>
            <h1>Debts</h1>
            <p>Track balances between group members.</p>
        </div>
    </div>

    <div class="debt-summary-grid">

        <div class="summary-card positive">
            <span>You are owed</span>
            <strong>€45.00</strong>
        </div>

        <div class="summary-card negative">
            <span>You owe</span>
            <strong>€20.00</strong>
        </div>

        <div class="summary-card">
            <span>Open Debts</span>
            <strong>3</strong>
        </div>

        <div class="summary-card">
            <span>Net Balance</span>
            <strong>+€25.00</strong>
        </div>

    </div>


    <div class="debts-card">

        <div class="debts-table-header">
            <span>From</span>
            <span>To</span>
            <span>Amount</span>
            <span>Status</span>
        </div>


        <div class="debt-row">

            <div class="person-cell">
                <div class="avatar">MX</div>

                <div>
                    <strong>Max</strong>
                    <span>Member</span>
                </div>
            </div>

            <div class="person-cell">
                <div class="avatar">SJ</div>

                <div>
                    <strong>Sebastian</strong>
                    <span>Member</span>
                </div>
            </div>

            <div class="debt-amount">
                €30.00
            </div>

            <span class="status open">
                Open
            </span>

        </div>


        <div class="debt-row">

            <div class="person-cell">
                <div class="avatar">LI</div>

                <div>
                    <strong>Lisa</strong>
                    <span>Member</span>
                </div>
            </div>

            <div class="person-cell">
                <div class="avatar">SJ</div>

                <div>
                    <strong>Sebastian</strong>
                    <span>Member</span>
                </div>
            </div>

            <div class="debt-amount">
                €15.00
            </div>

            <span class="status open">
                Open
            </span>

        </div>


        <div class="debt-row">

            <div class="person-cell">
                <div class="avatar">TM</div>

                <div>
                    <strong>Tom</strong>
                    <span>Member</span>
                </div>
            </div>

            <div class="person-cell">
                <div class="avatar">MX</div>

                <div>
                    <strong>Max</strong>
                    <span>Member</span>
                </div>
            </div>

            <div class="debt-amount">
                €22.00
            </div>

            <span class="status open">
                Open
            </span>

        </div>

    </div>


    <div class="optimization-card">

        <div>
            <span class="optimization-label">
                SMART SETTLEMENT
            </span>

            <h2>Optimized repayments</h2>

            <p>
                Reduce the number of transfers needed to settle all open debts.
            </p>
        </div>

        <button class="optimize-btn">
            Optimize Debts
        </button>

    </div>

</div>