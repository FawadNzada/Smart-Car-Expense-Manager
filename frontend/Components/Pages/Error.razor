@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<div class="status-page">

    <div class="status-card error-card">

        <div class="status-icon">
            !
        </div>

        <span class="status-label">
            APPLICATION ERROR
        </span>

        <h1>Something went wrong.</h1>

        <p class="status-text">
            An unexpected error occurred while processing your request.
            You can return to the dashboard and try again.
        </p>

        @if (ShowRequestId)
        {
            <div class="request-box">
                <span>Request ID</span>
                <code>@RequestId</code>
            </div>
        }

        <div class="status-actions">

            <a href="/dashboard" class="primary-action">
                Back to Dashboard
            </a>

            <a href="/" class="secondary-action">
                Go Home
            </a>

        </div>

        <div class="development-note">

            <h3>Development Information</h3>

            <p>
                Detailed exception information should only be displayed
                while developing the application locally.
            </p>

            <p>
                For local debugging, use the
                <strong>Development</strong> environment and restart the application.
            </p>

        </div>

    </div>

</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }

    private bool ShowRequestId =>
        !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId =
            Activity.Current?.Id
            ?? HttpContext?.TraceIdentifier;
    }
}