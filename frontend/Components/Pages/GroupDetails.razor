@page "/groups/{Id:int}"

@using frontend.Services

@inject GroupStore GroupStore
@inject VehicleStore VehicleStore
@inject NavigationManager Navigation

<PageTitle>Group Details</PageTitle>


<div class="group-details-page">

    @if (Group is null)
    {
        <div class="not-found-card">

            <h2>Group not found</h2>

            <p>
                This group could not be found.
            </p>

            <a href="/groups"
               class="primary-btn">
                Back to Groups
            </a>

        </div>
    }
    else
    {
        <a href="/groups"
           class="back-link">
            ← Back to Groups
        </a>


        <div class="details-header">

            <div>

                <span class="eyebrow">
                    GROUP DETAILS
                </span>

                <h1>
                    @Group.Name
                </h1>

                <p>
                    Manage members and assigned vehicles.
                </p>

            </div>


            <div class="header-actions">

                <a href="@($"/groups/edit/{Group.Id}")"
                   class="edit-btn">
                    Edit Group
                </a>

                <button type="button"
                        class="delete-btn"
                        @onclick="OpenDeleteModal">
                    Delete Group
                </button>

            </div>

        </div>


        <!-- OVERVIEW -->

        <div class="overview-card">

            <div class="group-icon">
                👥
            </div>


            <div class="overview-main">

                <span class="owner-label">
                    OWNER
                </span>

                <strong>
                    @Group.Owner
                </strong>

                <p>
                    @(string.IsNullOrWhiteSpace(Group.Description)
                        ? "No description."
                        : Group.Description)
                </p>

            </div>


            <div class="overview-stats">

                <div>
                    <span>Members</span>
                    <strong>@Group.Members.Count</strong>
                </div>

                <div>
                    <span>Vehicles</span>
                    <strong>@Group.VehicleLicensePlates.Count</strong>
                </div>

                <div>
                    <span>Created</span>
                    <strong>@Group.CreatedAt.ToString("dd MMM yyyy")</strong>
                </div>

            </div>

        </div>


        <div class="details-grid">

            <!-- MEMBERS -->

            <div class="details-card">

                <div class="card-header">

                    <div>
                        <span class="section-label">
                            PEOPLE
                        </span>

                        <h2>
                            Members
                        </h2>
                    </div>

                    <strong>
                        @Group.Members.Count
                    </strong>

                </div>


                <div class="member-list">

                    @foreach (var member in Group.Members)
                    {
                        <div class="member-row">

                            <div class="member-avatar">
                                @GetInitials(member)
                            </div>


                            <div class="member-info">

                                <strong>
                                    @member
                                </strong>

                                @if (member.Equals(
                                    Group.Owner,
                                    StringComparison.OrdinalIgnoreCase))
                                {
                                    <span>
                                        Group Owner
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Member
                                    </span>
                                }

                            </div>


                            @if (member.Equals(
                                Group.Owner,
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="owner-badge">
                                    Owner
                                </span>
                            }

                        </div>
                    }

                </div>

            </div>


            <!-- VEHICLES -->

            <div class="details-card">

                <div class="card-header">

                    <div>
                        <span class="section-label">
                            FLEET
                        </span>

                        <h2>
                            Assigned Vehicles
                        </h2>
                    </div>

                    <strong>
                        @AssignedVehicles.Count()
                    </strong>

                </div>


                @if (!AssignedVehicles.Any())
                {
                    <div class="empty-section">

                        <span>🚗</span>

                        <p>
                            No vehicles assigned.
                        </p>

                    </div>
                }
                else
                {
                    <div class="vehicle-list">

                        @foreach (var vehicle in AssignedVehicles)
                        {
                            <a href="@($"/vehicles/{vehicle.LicensePlate}")"
                               class="vehicle-row">

                                <div class="vehicle-image">

                                    <img src="@vehicle.Image"
                                         alt="@vehicle.Name" />

                                </div>


                                <div class="vehicle-info">

                                    <strong>
                                        @vehicle.Name
                                    </strong>

                                    <span>
                                        @vehicle.LicensePlate
                                    </span>

                                </div>


                                <span class="vehicle-status @vehicle.StatusClass">
                                    @vehicle.Status
                                </span>

                            </a>
                        }

                    </div>
                }

            </div>

        </div>


        @if (showDeleteModal)
        {
            <div class="modal-overlay">

                <div class="modal-card">

                    <h2>
                        Delete Group?
                    </h2>

                    <p>
                        The group "@Group.Name" will be permanently removed.
                    </p>


                    <div class="delete-summary">

                        <span>
                            @Group.Members.Count members
                        </span>

                        <span>
                            @Group.VehicleLicensePlates.Count vehicles
                        </span>

                    </div>


                    <div class="modal-actions">

                        <button type="button"
                                class="modal-secondary"
                                @onclick="CloseDeleteModal">
                            Back
                        </button>

                        <button type="button"
                                class="modal-danger"
                                @onclick="DeleteGroup">
                            Delete
                        </button>

                    </div>

                </div>

            </div>
        }

    }

</div>


@code {

    [Parameter]
    public int Id { get; set; }


    private GroupItem? Group;

    private bool showDeleteModal;


    private IEnumerable<VehicleItem> AssignedVehicles =>
        Group is null
            ? Enumerable.Empty<VehicleItem>()
            : VehicleStore.Vehicles.Where(
                vehicle =>
                    Group.VehicleLicensePlates.Contains(
                        vehicle.LicensePlate,
                        StringComparer.OrdinalIgnoreCase));


    protected override void OnParametersSet()
    {
        Group =
            GroupStore.FindGroup(Id);
    }


    private void OpenDeleteModal()
    {
        showDeleteModal = true;
    }


    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }


    private void DeleteGroup()
    {
        if (Group is null)
        {
            return;
        }


        GroupStore.DeleteGroup(Group);

        Navigation.NavigateTo(
            "/groups");
    }


    private string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }


        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries);


        if (parts.Length == 1)
        {
            return parts[0][0]
                .ToString()
                .ToUpper();
        }


        return
            $"{parts[0][0]}{parts[^1][0]}"
            .ToUpper();
    }

}