@page "/creategroup"

@using frontend.Services

@inject GroupStore GroupStore
@inject VehicleStore VehicleStore
@inject NavigationManager Navigation

<PageTitle>New Group</PageTitle>


<div class="create-group-page">

    <a href="/groups"
       class="back-link">
        ← Back to Groups
    </a>


    <div class="create-header">

        <span>
            GROUP MANAGEMENT
        </span>

        <h1>New Group</h1>

        <p>
            Create a carsharing group and assign members and vehicles.
        </p>

    </div>


    <div class="create-layout">


        <!-- FORM -->

        <div class="create-form-card">


            <div class="form-group">

                <label>Group Name</label>

                <input type="text"
                       placeholder="e.g. Weekend Crew"
                       @bind="groupName"
                       @bind:event="oninput" />

            </div>


            <div class="form-group">

                <label>Owner</label>

                <input type="text"
                       placeholder="e.g. Sebastian"
                       @bind="owner"
                       @bind:event="oninput" />

            </div>


            <div class="form-group">

                <label>Description</label>

                <textarea placeholder="What is this group used for?"
                          @bind="description"
                          @bind:event="oninput">
                </textarea>

            </div>


            <div class="form-group">

                <label>
                    Members
                </label>

                <input type="text"
                       placeholder="Lisa, Max, Sebastian"
                       @bind="membersText"
                       @bind:event="oninput" />

                <small>
                    Separate members with commas.
                </small>

            </div>


            <div class="vehicle-selection">

                <label>
                    Vehicles
                </label>


                @foreach (var vehicle in VehicleStore.Vehicles)
                {
                    <label class="vehicle-option">

                        <input type="checkbox"
                               checked="@IsVehicleSelected(vehicle.LicensePlate)"
                               @onchange="args => ToggleVehicle(vehicle.LicensePlate, args)" />


                        <div class="vehicle-option-image">

                            <img src="@vehicle.Image"
                                 alt="@vehicle.Name" />

                        </div>


                        <div class="vehicle-option-info">

                            <strong>
                                @vehicle.Name
                            </strong>

                            <span>
                                @vehicle.LicensePlate
                            </span>

                        </div>


                        <span class="vehicle-status @vehicle.StatusClass">
                            @vehicle.Status
                        </span>

                    </label>
                }

            </div>


            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="form-error">
                    @errorMessage
                </div>
            }


            <div class="form-actions">

                <a href="/groups"
                   class="cancel-btn">
                    Cancel
                </a>


                <button type="button"
                        class="create-btn"
                        @onclick="SaveGroup">

                    Create Group

                </button>

            </div>

        </div>



        <!-- PREVIEW -->

        <div class="group-preview-card">

            <span class="preview-label">
                GROUP PREVIEW
            </span>


            <div class="preview-icon">
                👥
            </div>


            <h2>
                @(string.IsNullOrWhiteSpace(groupName)
                    ? "Group Name"
                    : groupName)
            </h2>


            <span class="preview-owner">
                Owner:
                @(string.IsNullOrWhiteSpace(owner)
                    ? "Owner"
                    : owner)
            </span>


            <p>
                @(string.IsNullOrWhiteSpace(description)
                    ? "Your group description will appear here."
                    : description)
            </p>


            <div class="preview-stats">

                <div>

                    <span>Members</span>

                    <strong>
                        @PreviewMembers.Count
                    </strong>

                </div>


                <div>

                    <span>Vehicles</span>

                    <strong>
                        @selectedVehicles.Count
                    </strong>

                </div>

            </div>


            @if (PreviewMembers.Any())
            {
                <div class="preview-members">

                    @foreach (var member in PreviewMembers)
                    {
                        <span>
                            @member
                        </span>
                    }

                </div>
            }


            @if (SelectedVehicleObjects.Any())
            {
                <div class="preview-vehicles">

                    @foreach (var vehicle in SelectedVehicleObjects)
                    {
                        <div>

                            <img src="@vehicle.Image"
                                 alt="@vehicle.Name" />

                            <span>
                                @vehicle.Name
                            </span>

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>


@code {

    private string groupName = "";

    private string owner = "";

    private string description = "";

    private string membersText = "";

    private string errorMessage = "";


    private List<string> selectedVehicles =
        new();


    private List<string> PreviewMembers =>
        ParseMembers();


    private IEnumerable<VehicleItem> SelectedVehicleObjects =>
        VehicleStore.Vehicles.Where(
            vehicle =>
                selectedVehicles.Contains(
                    vehicle.LicensePlate,
                    StringComparer.OrdinalIgnoreCase));


    private bool IsVehicleSelected(
        string licensePlate)
    {
        return selectedVehicles.Contains(
            licensePlate,
            StringComparer.OrdinalIgnoreCase);
    }


    private void ToggleVehicle(
        string licensePlate,
        ChangeEventArgs args)
    {
        var isChecked =
            args.Value is bool value
            && value;


        if (isChecked)
        {
            if (!IsVehicleSelected(
                    licensePlate))
            {
                selectedVehicles.Add(
                    licensePlate);
            }
        }
        else
        {
            selectedVehicles.RemoveAll(
                plate =>
                    plate.Equals(
                        licensePlate,
                        StringComparison.OrdinalIgnoreCase));
        }
    }


    private List<string> ParseMembers()
    {
        return membersText
            .Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries)
            .Select(member =>
                member.Trim())
            .Where(member =>
                !string.IsNullOrWhiteSpace(member))
            .Distinct(
                StringComparer.OrdinalIgnoreCase)
            .ToList();
    }


    private void SaveGroup()
    {
        errorMessage = "";


        if (string.IsNullOrWhiteSpace(
                groupName))
        {
            errorMessage =
                "Please enter a group name.";

            return;
        }


        if (GroupStore.GroupNameExists(
                groupName.Trim()))
        {
            errorMessage =
                "A group with this name already exists.";

            return;
        }


        if (string.IsNullOrWhiteSpace(
                owner))
        {
            errorMessage =
                "Please enter a group owner.";

            return;
        }


        var members =
            ParseMembers();


        if (!members.Any(
                member =>
                    member.Equals(
                        owner.Trim(),
                        StringComparison.OrdinalIgnoreCase)))
        {
            members.Insert(
                0,
                owner.Trim());
        }


        var group =
            new GroupItem
            {
                Name =
                    groupName.Trim(),

                Owner =
                    owner.Trim(),

                Description =
                    description.Trim(),

                CreatedAt =
                    DateTime.Today,

                Members =
                    members,

                VehicleLicensePlates =
                    new List<string>(
                        selectedVehicles)
            };


        GroupStore.AddGroup(
            group);


        Navigation.NavigateTo(
            "/groups");
    }

}