@page "/reservations"

<PageTitle>Reservations</PageTitle>

<div class="reservations-page">

    <div class="reservations-header">
        <div>
            <h1>Reservations</h1>
            <p>Manage and view all vehicle reservations.</p>
        </div>

        <a href="/createreservation" class="new-reservation-btn">
            + New Reservation
        </a>
    </div>

    <div class="reservation-tabs">
        <button class="tab active">All</button>
        <button class="tab">Upcoming</button>
        <button class="tab">Past</button>
        <button class="tab">Cancelled</button>
    </div>

    <div class="reservations-list">

        <div class="reservation-card">
            <div class="reservation-car">
                <img src="images/vehicles/vw.png"
                     alt="Volkswagen Golf" />
            </div>

            <div class="reservation-main">
                <h3>Volkswagen Golf</h3>
                <span class="plate">L-123AB</span>
            </div>

            <div class="reservation-user">
                <span class="label">Driver</span>
                <strong>Sebastian</strong>
            </div>

            <div class="reservation-date">
                <span class="label">Date</span>
                <strong>Today</strong>
            </div>

            <div class="reservation-time">
                <span class="label">Time</span>
                <strong>15:00 - 18:00</strong>
            </div>

            <span class="status upcoming">
                Upcoming
            </span>
        </div>


        <div class="reservation-card">
            <div class="reservation-car">
                <img src="images/vehicles/bmw.png"
                     alt="BMW 3 Series" />
            </div>

            <div class="reservation-main">
                <h3>BMW 3 Series</h3>
                <span class="plate">L-456CD</span>
            </div>

            <div class="reservation-user">
                <span class="label">Driver</span>
                <strong>Lisa</strong>
            </div>

            <div class="reservation-date">
                <span class="label">Date</span>
                <strong>Tomorrow</strong>
            </div>

            <div class="reservation-time">
                <span class="label">Time</span>
                <strong>09:00 - 12:00</strong>
            </div>

            <span class="status planned">
                Planned
            </span>
        </div>


        <div class="reservation-card">
            <div class="reservation-car">
                <img src="images/vehicles/audi.png"
                     alt="Audi A4" />
            </div>

            <div class="reservation-main">
                <h3>Audi A4</h3>
                <span class="plate">L-789EF</span>
            </div>

            <div class="reservation-user">
                <span class="label">Driver</span>
                <strong>Max</strong>
            </div>

            <div class="reservation-date">
                <span class="label">Date</span>
                <strong>Friday</strong>
            </div>

            <div class="reservation-time">
                <span class="label">Time</span>
                <strong>10:00 - 14:00</strong>
            </div>

            <span class="status planned">
                Planned
            </span>
        </div>

    </div>

</div>